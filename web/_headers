# Cloudflare Workers static assets — заголовки для ADDate web (web.addate.ru)
#
# Файл лежит в каталоге assets (./web) и разбирается Wrangler'ом: сам он
# не отдаётся как статический файл. Для разбора нужен wrangler 4.x —
# версия зафиксирована в .github/workflows/deploy.yml.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), microphone=(), geolocation=(self)
  Strict-Transport-Security: max-age=31536000

/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/_expo/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
